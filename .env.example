# Neon connection string (Vercel injects this automatically once you attach the DB)
DATABASE_URL="postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# The PIN your admins type to unlock editing. Pick something only you know.
ADMIN_PIN="change-me"

# Any long random string. Used to sign the admin cookie.
AUTH_SECRET="run: openssl rand -hex 32"
