# ---------------------------------------------------------------------------
# Per-deployment settings. One codebase can serve several alliances: give each
# its own Vercel project, its own Neon database, and its own values here.
# ---------------------------------------------------------------------------

# Neon connection string (Vercel injects this automatically once you attach the DB)
DATABASE_URL="postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# The PIN your admins type to unlock editing. Pick something only you know.
ADMIN_PIN="change-me"

# Any long random string. Used to sign the admin cookie.
AUTH_SECRET="run: openssl rand -hex 32"

# --- optional, defaults shown ---

# Shown in the header and browser tab.
ALLIANCE_NAME="SkyGat"

# Colour and display-type scheme: brass (steel and amber) or jade (indigo and green).
THEME="brass"

# Roster cap.
MEMBER_LIMIT="25"
